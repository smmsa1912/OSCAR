GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OSCAR_LOG_LEVEL=INFO
MAX_STEPS=25
ACTION_DELAY=0.5
APP_LAUNCH_DELAY=1.5
WINDOW_FOCUS_TIMEOUT=2.0
SAVE_DIALOG_DELAY=0.75
FOCUS_SETTLE_DELAY=0.35
TYPEWRITE_INTERVAL=0.07
ENABLE_SCREENSHOT_GRID=true
SCREENSHOT_GRID_INTERVAL=100
ENABLE_CLICK_REFINEMENT=true
CLICK_REFINEMENT_RADIUS=220
CLICK_REFINEMENT_MAX_SHIFT=90
TERMINAL_TIMEOUT_SECONDS=20
TERMINAL_OUTPUT_LIMIT=4000
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_SECONDS=10
PLAYWRIGHT_MANAGED_PROFILE_DIR=
RETRY_INITIAL_INTERVAL_SECONDS=0.05
RETRY_MAX_INTERVAL_SECONDS=0.5
RETRY_BACKOFF_FACTOR=1.6
MAX_ROUTE_ATTEMPTS=4
ROUTE_FAILURE_PENALTY=40
# Format: left,top,width,height (e.g., 0,0,1920,1080)
SCREENSHOT_REGION=


