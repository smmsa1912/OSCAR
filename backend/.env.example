GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Select one provider: gemini (default), omniroute, or freellmapi
LLM_PROVIDER=gemini
# OpenAI-compatible OmniRoute API prefix; typically ends in /v1
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# These OmniRoute auto/* model IDs were returned by your local /models endpoint.
# Keep LLM_PROVIDER=gemini until you intentionally enable and verify OmniRoute.
OMNIROUTE_MODEL=auto/best-fast
OMNIROUTE_AUTO_ROUTING=true
OMNIROUTE_MODEL_FAST=auto/best-fast
OMNIROUTE_MODEL_REASONING=auto/best-reasoning
OMNIROUTE_MODEL_VISION=auto/vision
OMNIROUTE_MODEL_FALLBACK=auto/best-fast
OMNIROUTE_TIMEOUT_SECONDS=45

FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_VISION_MODEL=auto
FREELLMAPI_TIMEOUT_SECONDS=45
FREELLMAPI_MAX_PROMPT_CHARS=5000
FREELLMAPI_MAX_OUTPUT_TOKENS=350
FREELLMAPI_MAX_REQUEST_TOKENS=8000
FREELLMAPI_MAX_IMAGE_DIMENSION=1024

# Cloud-token guardrails. Estimates are conservative, not exact billing tokenizer counts.
OMNIROUTE_MAX_PROMPT_CHARS=7000
OMNIROUTE_MAX_OUTPUT_TOKENS=350
OMNIROUTE_MAX_REQUEST_TOKENS=5000
OMNIROUTE_MAX_TASK_TOKENS=20000
OMNIROUTE_MAX_DAILY_TOKENS=30000
OMNIROUTE_MAX_IMAGE_DIMENSION=1024
OSCAR_LOG_LEVEL=INFO
MAX_STEPS=25
ACTION_DELAY=0.5
APP_LAUNCH_DELAY=1.5
WINDOW_FOCUS_TIMEOUT=2.0
SAVE_DIALOG_DELAY=0.75
FOCUS_SETTLE_DELAY=0.35
TYPEWRITE_INTERVAL=0.07
ENABLE_SCREENSHOT_GRID=true
SCREENSHOT_GRID_INTERVAL=100
ENABLE_CLICK_REFINEMENT=true
CLICK_REFINEMENT_RADIUS=220
CLICK_REFINEMENT_MAX_SHIFT=90
TERMINAL_TIMEOUT_SECONDS=20
TERMINAL_OUTPUT_LIMIT=4000
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_SECONDS=10
PLAYWRIGHT_MANAGED_PROFILE_DIR=
RETRY_INITIAL_INTERVAL_SECONDS=0.05
RETRY_MAX_INTERVAL_SECONDS=0.5
RETRY_BACKOFF_FACTOR=1.6
MAX_ROUTE_ATTEMPTS=4
ROUTE_FAILURE_PENALTY=40
# Format: left,top,width,height (e.g., 0,0,1920,1080)
SCREENSHOT_REGION=



# Safety mode: log intended actions without performing desktop/browser actions.
OSCAR_DRY_RUN=true
